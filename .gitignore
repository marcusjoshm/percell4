htmlcov/

# OS
.DS_Store
Thumbs.db

# Data files (large, not version controlled)
*.h5
*.sdt
*.ptu
*.bin
*.lif
*.czi

# Test / scratch outputs from running the app
*.csv
*.xlsx
*.xls
# ...but test-fixture CSVs are committed parity baselines the suite reads.
!tests/fixtures/**/*.csv

# R
.Rhistory
.Rdata
.Rproj.user/

# Local agent context — kept on disk but never pushed to the remote repo.
# Per-developer context-engineering files and tool hooks. The agent-generated
# documentation trees are excluded further down.
.claude/
.cursor/
CLAUDE.md
compound-engineering.local.md
.worktrees

# Developer scratch: one-off data-propagation scripts, ImageJ macros, and
# tool hooks. Kept on disk for reuse but never part of the tracked platform.
scripts/

# Retired development artifact (adaptive SG puncta recipe), archived but untracked.
docs/archive/locked_SG.json

# Agent / tool context caches
.context/

# Scratch SVG exports at repo root (analysis runs).
# docs/**/*.svg and src/**/*.svg remain trackable.
/*.svg

# Separate Tauri/Node desktop-app project living in the repo dir (incl. node_modules).
/desktop/

# Compound Engineering config — machine-local on every dev machine, never shared.
.compound-engineering/

# Agentic context documentation: plans, learnings, brainstorms, audit write-ups,
# and archived working notes. Kept on disk so the agent workflows and the
# docs/ path citations in src/ docstrings still resolve locally, but never
# pushed. Only SOFTWARE documentation stays tracked under docs/:
# reference/, paper/, audits/*.yaml, and the top-level guides.
docs/plans/
docs/solutions/
docs/brainstorms/
docs/ideation/
docs/initiatives/
docs/methods/
docs/archive/
docs/audits/*.md
