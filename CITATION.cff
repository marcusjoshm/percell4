# This CITATION.cff makes the repository citable and drives GitHub's
# "Cite this repository" button. See https://citation-file-format.github.io/
#
# TODO: before sharing, fill in the real author list and the JCB tools-paper
# fields marked "TODO" below (they are currently placeholders). GitHub will
# still render the citation button with placeholders present, but published
# citations should not go out with them.
cff-version: 1.2.0
message: "If you use this software, please cite both the software and the paper below."
title: PerCell4
abstract: >-
  Single-cell FLIM microscopy analysis platform — Cellpose segmentation,
  per-cell measurements, grouped thresholding, puncta detection, and phasor
  workflows in one Qt desktop application.
type: software
version: 0.1.0
license: MIT
repository-code: "https://github.com/marcusjoshm/percell4"
url: "https://github.com/marcusjoshm/percell4"
keywords:
  - single-cell analysis
  - microscopy
  - FLIM
  - phasor
  - Cellpose
  - image analysis
authors:
  # TODO: replace with the real author list, in citation order.
  - name: "Lee Lab"
    # - family-names: "Marcus"
    #   given-names: "Joshua M."
    # - family-names: "Lee"
    #   given-names: "..."

# The paper to cite in preference to (or alongside) the software itself.
# TODO: fill in the real authors, exact title, year, and DOI of the JCB tools paper.
preferred-citation:
  type: article
  title: "TODO: exact title of the JCB tools paper"
  journal: "Journal of Cell Biology"
  authors:
